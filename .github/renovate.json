{
  "timezone": "Europe/Madrid",
  "npm": {
    "minimumReleaseAge": "1 day"
  },
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies",
        "pnpm.catalog.runtime"
      ],
      "groupName": "npm (runtime)"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies",
        "pnpm.catalog.development",
        "engines",
        "packageManager"
      ],
      "groupName": "npm (development)"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "peerDependencies"
      ],
      "matchUpdateTypes": [
        "pin"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions",
        "devcontainer"
      ],
      "separateMajorMinor": false,
      "groupName": "ci"
    },
    {
      "matchFileNames": [
        "packaging/tauri/**",
        "packages/tauri-runtime/**"
      ],
      "separateMajorMinor": false,
      "groupName": "tauri"
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "groupName": "lockfiles",
      "dependencyDashboardApproval": true
    },
    {
      "matchDepNames": [
        "pnpm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "pnpm"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "node"
      ],
      "enabled": true,
      "versionCompatibility": "^(?<version>[^-]+)(?<compatibility>-.*)?$"
    },
    {
      "matchPackageNames": [
        "node",
        "actions/node-versions"
      ],
      "versioning": "node",
      "groupName": "node"
    },
    {
      "matchPackageNames": [
        "node",
        "actions/node-versions"
      ],
      "rangeStrategy": "replace"
    },
    {
      "matchPackageNames": [
        "node"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "rangeStrategy": "widen"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the NodeSource major pinned in the devcontainer Dockerfile (setup_XX.x). Version-only bump: the hosted Renovate GitHub App can't run postUpgradeTasks to verify the NodeSource repo URL exists for the new major before opening the PR (that requires self-hosted Renovate with an admin-configured allowedCommands).",
      "managerFilePatterns": [
        ".devcontainer/Dockerfile"
      ],
      "matchStrings": [
        "setup_(?<currentValue>\\d+)\\.x"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node",
      "versioningTemplate": "node",
      "autoReplaceStringTemplate": "setup_{{{newValue}}}.x"
    }
  ],
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "vulnerable",
    "labels": [
      "security",
      "dependencies"
    ],
    "separateMajorMinor": false,
    "vulnerabilityFixStrategy": "highest"
  },
  "ignoreDeps": [
    "vuetify"
  ],
  "enabledManagers": [
    "npm",
    "github-actions",
    "cargo",
    "devcontainer",
    "dockerfile",
    "custom.regex"
  ],
  "labels": [
    "dependencies"
  ],
  "rebaseWhen": "behind-base-branch",
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true,
    "groupName": "lockfiles",
    "schedule": [
      "every month"
    ]
  },
  "assignees": [
    "ferferga",
    "ThibaultNocchi"
  ],
  "reviewers": [
    "ferferga",
    "ThibaultNocchi"
  ],
  "extends": [
    "mergeConfidence:age-confidence-badges",
    "helpers:pinGitHubActionDigests"
  ]
}
