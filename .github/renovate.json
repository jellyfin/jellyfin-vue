{
  "timezone": "Europe/Madrid",
  "npm": {
    "minimumReleaseAge": "1 day"
  },
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies",
        "pnpm.catalog.runtime"
      ],
      "groupName": "npm (runtime)"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies",
        "pnpm.catalog.development",
        "engines",
        "packageManager"
      ],
      "groupName": "npm (development)"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "peerDependencies"
      ],
      "matchUpdateTypes": [
        "pin"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions",
        "devcontainer"
      ],
      "separateMajorMinor": false,
      "groupName": "ci"
    },
    {
      "matchFileNames": [
        "packaging/tauri/**",
        "packages/tauri-runtime/**"
      ],
      "separateMajorMinor": false,
      "groupName": "tauri"
    },
    {
      "description": "A packageRule rather than lockFileMaintenance.groupName, so it comes after the tauri group and its lock files aren't split into another branch.",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "groupName": "lockfiles",
      "dependencyDashboardApproval": true
    },
    {
      "matchDepNames": [
        "pnpm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "pnpm"
    },
    {
      "description": "versioning: the Docker image would use docker versioning otherwise, which proposes new majors before they become LTS. versionCompatibility: node versioning can't parse the -slim suffix of the Docker tag. rangeStrategy: keeps the major-only values (setup-node, NodeSource) unpinned. separateMajorMinor: overrides the one set by the ci group, so setup-node doesn't get its own branch.",
      "matchPackageNames": [
        "node",
        "actions/node-versions"
      ],
      "versioning": "node",
      "versionCompatibility": "^(?<version>[^-]+)(?<compatibility>-.*)?$",
      "rangeStrategy": "replace",
      "separateMajorMinor": true,
      "groupName": "node"
    },
    {
      "description": "engines.node is handled by the custom manager below: the npm manager can't move both bounds of a '>=x <y' range ('widen' only raises the upper one, 'replace' drops the lower one and 'bump' falls back to 'widen').",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "node"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "enabled": false
    },
    {
      "description": "Keeps the engines.node minimum at the first LTS release of its major.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "node"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version-only bump: the hosted Renovate GitHub App can't run postUpgradeTasks to verify the NodeSource repo URL exists for the new major before opening the PR (that requires self-hosted Renovate with an admin-configured allowedCommands).",
      "managerFilePatterns": [
        ".devcontainer/Dockerfile"
      ],
      "matchStrings": [
        "setup_(?<currentValue>\\d+)\\.x"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "autoReplaceStringTemplate": "setup_{{{newValue}}}.x"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "package.json"
      ],
      "matchStrings": [
        "\"node\":\\s*\">=(?<currentValue>\\d+\\.\\d+\\.\\d+) <\\d+\\.0\\.0\""
      ],
      "depNameTemplate": "node",
      "depTypeTemplate": "engines",
      "datasourceTemplate": "node-version",
      "autoReplaceStringTemplate": "\"node\": \">={{{newValue}}} <{{add newMajor 1}}.0.0\""
    }
  ],
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "groupName": "vulnerable",
    "addLabels": [
      "security"
    ],
    "separateMajorMinor": false,
    "vulnerabilityFixStrategy": "highest"
  },
  "ignoreDeps": [
    "vuetify"
  ],
  "enabledManagers": [
    "npm",
    "github-actions",
    "cargo",
    "devcontainer",
    "dockerfile",
    "custom.regex"
  ],
  "labels": [
    "dependencies"
  ],
  "rebaseWhen": "behind-base-branch",
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "every month"
    ]
  },
  "assignees": [
    "ferferga",
    "ThibaultNocchi"
  ],
  "reviewers": [
    "ferferga",
    "ThibaultNocchi"
  ],
  "extends": [
    "mergeConfidence:age-confidence-badges",
    "helpers:pinGitHubActionDigests"
  ]
}
